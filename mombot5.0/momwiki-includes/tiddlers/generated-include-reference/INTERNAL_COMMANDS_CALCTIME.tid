setvar $INTERNAL_COMMANDS~MINUTES 0
setvar $INTERNAL_COMMANDS~SECONDS 0
setvar $INTERNAL_COMMANDS~TESTTIME $INTERNAL_COMMANDS~TIMETOLOGBACKIN
