setvar $PLAYER~DROPFIGS TRUE
setvar $PLAYER~RESULT $PLAYER~RESULT&amp;&quot;m &quot;&amp;$PLAYER~MOVEINTOSECTOR&amp;&quot;*&quot;
if (($PLAYER~MOVEINTOSECTOR &gt; 10) and ($PLAYER~MOVEINTOSECTOR &lt;&gt; $MAP~STARDOCK))
